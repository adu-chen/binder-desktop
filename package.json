{
  "name": "binder",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "npm run verify:bundled-tools && tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:governance": "vitest run scripts/test_governance.test.mjs && node scripts/test_governance.mjs audit",
    "test:inventory": "node scripts/test_governance.mjs inventory",
    "test:plan": "node scripts/test_governance.mjs select",
    "test:related": "node scripts/test_governance.mjs run",
    "test:full": "npm test && cargo test --manifest-path src-tauri/Cargo.toml",
    "product:test": "vitest run scripts/test_governance.test.mjs -t \"Product Capability Graph\"",
    "product:generate": "node scripts/generate_product_capability_atlas.mjs",
    "product:audit": "node scripts/audit_product_capability.mjs",
    "tauri": "tauri",
    "governance:generate": "node scripts/generate_adus.mjs",
    "governance:audit": "node scripts/audit_taskflow_governance.mjs",
    "verify:bundled-tools": "bash scripts/verify_bundled_tools.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tiptap/extension-character-count": "^3.27.1",
    "@tiptap/extension-color": "^3.27.1",
    "@tiptap/extension-font-family": "^3.27.1",
    "@tiptap/extension-highlight": "^3.27.1",
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-list": "^3.27.1",
    "@tiptap/extension-subscript": "^3.27.1",
    "@tiptap/extension-superscript": "^3.27.1",
    "@tiptap/extension-table": "^3.27.1",
    "@tiptap/extension-table-cell": "^3.27.1",
    "@tiptap/extension-table-header": "^3.27.1",
    "@tiptap/extension-table-row": "^3.27.1",
    "@tiptap/extension-text-align": "^3.27.1",
    "@tiptap/extension-text-style": "^3.27.1",
    "@tiptap/extension-underline": "^3.27.1",
    "@tiptap/markdown": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^27.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^3.2.6"
  }
}
