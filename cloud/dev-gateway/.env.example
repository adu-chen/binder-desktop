# dev-gateway 环境变量示例 —— 复制为 .env 后填入你的值。
# .env 已 gitignore（不入仓）；npm start 经 --env-file-if-exists=.env 自动加载（缺文件不报错）。

# 平台模型 key（任填其一即可用对应供应商；不配则需走 BYOK）
GW_DEEPSEEK_KEY=sk-your-deepseek-key
# GW_OPENAI_KEY=sk-your-openai-key
# GW_ANTHROPIC_KEY=sk-ant-your-key

# 可选
# GW_PORT=8787           # 监听端口（默认 8787）
# GW_DAILY_QUOTA=50      # 单用户每日额度（默认 50）
# GW_MASTER_KEY=         # 信封加密 KEK（32B hex/base64）；不配则用本地 .data/gw.master.key
# GW_KMS_PROVIDER=local  # 默认 local；aws/gcp 在正式云仓实现
